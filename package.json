{
  "name": "dsh-workbuddy-helper",
  "version": "0.6.1",
  "description": "Session assistant for DeepSeek Harness: expert picker, per-session skills/connector gating, WorkBuddy skill & connector markets, composer panel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./auth": "./lib/auth.js",
    "./connector": "./lib/connector.js",
    "./market": "./lib/market.js",
    "./portal": "./lib/portal.js",
    "./bundle": "./lib/bundle.js",
    "./session-plugin": "./lib/session-plugin.js",
    "./skill-providers": "./lib/skill-providers.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "tar": "^7.5.22",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "expert",
    "skills",
    "workbuddy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/awswt/dsh-workbuddy-helper.git"
  },
  "homepage": "https://github.com/awswt/dsh-workbuddy-helper",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/INSTALLATION-AND-TEST-REPORT.md",
    "docs/dsh-workbuddy-helper-design.md",
    "docs/workbuddy-connector-reverse-engineering.md",
    "docs/e2e-baseline.md",
    "docs/connector-upgrade-test-report.md",
    "docs/ui-*.png"
  ],
  "publishConfig": {
    "access": "public"
  }
